<Project>
  <PropertyGroup>
    <!-- ZeroCool AI Coding Pipeline: Deterministic Quality & Security Baseline (.NET 10+ LTS) -->
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <!--
    Optional zero-token static analyzers (uncomment to enforce in CI/local builds):
    <ItemGroup>
      <PackageReference Include="Meziantou.Analyzer" Version="2.*" PrivateAssets="all" />
      <PackageReference Include="SonarAnalyzer.CSharp" Version="10.*" PrivateAssets="all" />
    </ItemGroup>
  -->
</Project>

